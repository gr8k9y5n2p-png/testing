# Aftertax website env (do not put live secrets in git)

# Public origin for metadata + Stripe return URLs.
# Prefer staging until ads are green-lit. Production apex is getaftertax.com.
# AFTERTAX_PUBLIC_URL=https://staging.getaftertax.com
# AFTERTAX_PUBLIC_URL=https://getaftertax.com

# Data team FastAPI (PR #2). When set, the UI calls that host for
# POST /illustrate, POST /illustrate/compare, POST /illustrate/portfolio,
# POST /illustrate/portfolio/compare, GET /performance, POST /performance/growth,
# GET /funds (unique-fund list: limit/offset/total), GET /distributions,
# GET /coverage, GET /fund-families, POST /coverage/gaps.
# If the host is down, illustrate/performance use local /api/* mocks.
# Search / Sample Estimates stay empty (no seed.ts backfill).
# NEXT_PUBLIC_DATA_API_URL=http://localhost:8000

# Optional illustrate-only override (otherwise ${NEXT_PUBLIC_DATA_API_URL}/illustrate,
# then local mock /api/illustrate):
# NEXT_PUBLIC_ILLUSTRATE_URL=http://localhost:8000/illustrate

# Optional compare-only override (otherwise ${NEXT_PUBLIC_DATA_API_URL}/illustrate/compare,
# then local mock /api/illustrate/compare):
# NEXT_PUBLIC_COMPARE_URL=http://localhost:8000/illustrate/compare

# Optional portfolio-compare override (otherwise ${NEXT_PUBLIC_DATA_API_URL}/illustrate/portfolio/compare,
# then local mock /api/illustrate/portfolio/compare):
# NEXT_PUBLIC_PORTFOLIO_COMPARE_URL=http://localhost:8000/illustrate/portfolio/compare

# Temporary beta unlock — revert before launch / freemium sprint.
# Soft-wall is OFF when this is unset, true, or 1 (default). Eric does not
# need to set it on Vercel. Stored localStorage counters are ignored too.
# NEXT_PUBLIC_FREEMIUM_DISABLED=true
# Restore 3-search + Import paywall gates:
# NEXT_PUBLIC_FREEMIUM_DISABLED=false

# Friends-beta shared password (server-only). Set in Vercel Production
# (Settings → Environment Variables) to lock the app UI. Unset to go public.
# Alias: BETA_PASSWORD. Do not prefix with NEXT_PUBLIC_.
# FRIENDS_BETA_PASSWORD=

# Stripe Checkout — Aftertax website owns session creation (server-side).
# Test mode later. Do not block on live keys; demo/staging work without these.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=price_1UD6C0RqA7bY5N5qVleZso0d
# Product prod_VDXGeprN4QkxsM  account acct_1UD66TRqA7bY5N5q
# success_url → ${AFTERTAX_PUBLIC_URL}/?checkout=success (same search flow)
# cancel_url  → ${AFTERTAX_PUBLIC_URL}/?checkout=cancel (paywall)
