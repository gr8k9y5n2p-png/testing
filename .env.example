# Aftertax website env (do not put live secrets in git)

# Public origin for metadata + Stripe return URLs.
# Prefer staging until ads are green-lit. Production apex is getaftertax.com.
# AFTERTAX_PUBLIC_URL=https://staging.getaftertax.com
# AFTERTAX_PUBLIC_URL=https://getaftertax.com

# Data team FastAPI (PR #2). When set, the UI calls that host for
# POST /illustrate, POST /illustrate/compare, POST /illustrate/portfolio,
# POST /illustrate/portfolio/compare, GET /performance, POST /performance/growth,
# GET /funds (unique-fund list: limit/offset/total), GET /distributions,
# GET /coverage, GET /fund-families, POST /coverage/gaps.
# If the host is down, illustrate / compare / portfolio fail honestly —
# they do not fall back to local /api/* mocks (those banners are MOCK chrome).
# Search / Sample Estimates stay empty (no seed.ts backfill).
# NEXT_PUBLIC_DATA_API_URL=http://localhost:8000

# Optional illustrate-only override (otherwise ${NEXT_PUBLIC_DATA_API_URL}/illustrate,
# then local mock /api/illustrate):
# NEXT_PUBLIC_ILLUSTRATE_URL=http://localhost:8000/illustrate

# Optional compare-only override (otherwise ${NEXT_PUBLIC_DATA_API_URL}/illustrate/compare,
# then local mock /api/illustrate/compare):
# NEXT_PUBLIC_COMPARE_URL=http://localhost:8000/illustrate/compare

# Optional portfolio-compare override (otherwise ${NEXT_PUBLIC_DATA_API_URL}/illustrate/portfolio/compare,
# then local mock /api/illustrate/portfolio/compare):
# NEXT_PUBLIC_PORTFOLIO_COMPARE_URL=http://localhost:8000/illustrate/portfolio/compare

# Soft-wall is ON by default (10 searches / 3 compares / 3 portfolio reviews).
# Set true only to bypass counters for an internal demo.
# NEXT_PUBLIC_FREEMIUM_DISABLED=false

# Friends-beta shared password (server-only). Set in Vercel Production
# (Settings → Environment Variables) to lock the app UI. Unset to go public.
# Alias: BETA_PASSWORD. Do not prefix with NEXT_PUBLIC_.
# FRIENDS_BETA_PASSWORD=

# Account session HMAC (email/password). Default is a local/dev secret.
# AFTERTAX_ACCOUNT_SECRET=
# Pin the accounts JSON to a persistent disk in production. Default is
# .data/accounts.json locally and /tmp/aftertax-accounts.json on Vercel
# (ephemeral per instance — sign-in will miss rows written elsewhere).
# AFTERTAX_ACCOUNTS_PATH=
#
# Password-reset email — Resend transactional (not Gmail).
# Vercel: set RESEND_API_KEY on Production + Preview.
# DNS: in Resend → Domains add getaftertax.com, then publish the
# exact DKIM + SPF (+ optional DMARC) records from that dashboard.
# From defaults to Aftertax <noreply@getaftertax.com> once the
# domain is verified. No mailbox required for noreply@.
# Without RESEND_API_KEY the token API still runs; the UI says mail
# is not configured (it does not pretend a message was sent).
# Non-prod logs the reset URL. Production does not.
# RESEND_API_KEY=
# AFTERTAX_MAIL_FROM=Aftertax <noreply@getaftertax.com>

# Saved assets JSON file (lists + portfolios). Default: .data/saved-assets.json
# locally, /tmp/aftertax-saved-assets.json on Vercel. Ephemeral on serverless —
# swap the SavedAssetStore for Neon/Postgres later. No new cloud vendor.
# SAVED_ASSETS_PATH=

# Stripe (Vercel → Project → Settings → Environment Variables).
# Charge-ready: set these on Production + Preview. Do not commit real keys.
# Soft-fails without them (501, CTA says billing is not configured).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_ID=price_1UD6C0RqA7bY5N5qVleZso0d
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRODUCT_ID=prod_VDXGeprN4QkxsM
# Product prod_VDXGeprN4QkxsM  account acct_1UD66TRqA7bY5N5q
# Webhook endpoint: ${AFTERTAX_PUBLIC_URL}/api/stripe/webhook
#   events: checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.paid (optional)
# Customer Portal: enable cancel-at-period-end in Stripe Dashboard
#   Settings → Billing → Customer portal.
# success_url → ${AFTERTAX_PUBLIC_URL}/?checkout=success&session_id={CHECKOUT_SESSION_ID}
# cancel_url  → ${AFTERTAX_PUBLIC_URL}/?checkout=cancel
