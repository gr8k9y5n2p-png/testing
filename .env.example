# SQLite (default) — relative to the process working directory
DATABASE_URL=sqlite:///./data/distributions.db

# Postgres (production)
# DATABASE_URL=postgresql+psycopg://distributions:distributions@localhost:5432/distributions

# fixture = parse bundled HTML (offline demo)
# live    = HTTP GET Capital Group public tax-center pages
FETCH_MODE=fixture

# Boot seed in a background thread so GET /health is 200 as soon as HTTP listens.
# Empty DB: full fixture ingest (same records as POST /ingest/fetch all).
# Warm disk (Render /var/data): densify missing families / changed fixtures only.
# health.seed is running|complete. Leave true on Render starter; do not set
# SEED_FORCE_FULL unless you intend a full rebuild (can OOM 512MB during parse).
SEED_ON_START=false
SEED_FORCE_FULL=false
# One uvicorn worker. Multiple workers on one SQLite file cause 502s.
WEB_CONCURRENCY=1

# Flag per_share rows more than ±50% vs the category median (same year + type).
# 50 → high = median × 1.5, low = median × 0.5. Never auto-deletes.
CATEGORY_OUTLIER_THRESHOLD_PCT=50
CATEGORY_OUTLIER_MIN_PEERS=3

# Browser origins for the Aftertax Website (comma-separated). Vercel previews also
# match CORS_ORIGIN_REGEX.
CORS_ORIGINS=https://testing-seven-umber-19.vercel.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app
